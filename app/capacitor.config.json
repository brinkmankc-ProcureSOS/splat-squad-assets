{
  "appId": "com.brinkmanventures.hypebeam",
  "appName": "Hypebeam",
  "webDir": "www",
  "server": {
    "url": "https://splat-squad.brinkman-kc.workers.dev/?app=1",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "backgroundColor": "#0b0820",
  "ios": { "contentInset": "never", "allowsLinkPreview": false },
  "android": { "allowMixedContent": false },
